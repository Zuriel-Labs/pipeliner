{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Zuriel-Labs/pipeliner/blob/main/schema/pipeliner.schema.json",
  "title": "Pipeliner repository profile",
  "description": "Repository-owned configuration for an agent-managed development and release pipeline.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "repository", "project", "workflow", "quality", "release"],
  "properties": {
    "qa": { "$ref": "#/$defs/qa" },
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "name", "defaultBranch", "projectManager"],
      "properties": {
        "owner": { "$ref": "#/$defs/nonEmptyString" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "defaultBranch": { "$ref": "#/$defs/nonEmptyString" },
        "projectManager": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "number", "title", "statusField", "statuses", "metadataFields"],
      "properties": {
        "owner": { "$ref": "#/$defs/nonEmptyString" },
        "number": { "type": "integer", "minimum": 0 },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "visibility": { "enum": ["PUBLIC", "PRIVATE"], "description": "Expected Project visibility. Omission reports observed visibility without inheriting or changing it." },
        "statusField": { "$ref": "#/$defs/nonEmptyString" },
        "statuses": {
          "type": "object",
          "additionalProperties": false,
          "required": ["backlog", "onHold", "inProgress", "inReview", "done"],
          "properties": {
            "backlog": { "$ref": "#/$defs/nonEmptyString" },
            "onHold": { "$ref": "#/$defs/nonEmptyString" },
            "inProgress": { "$ref": "#/$defs/nonEmptyString" },
            "inReview": { "$ref": "#/$defs/nonEmptyString" },
            "done": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        "metadataFields": {
          "type": "object",
          "additionalProperties": false,
          "required": ["priority", "impact", "effort"],
          "properties": {
            "priority": { "$ref": "#/$defs/projectField" },
            "impact": { "$ref": "#/$defs/projectField" },
            "effort": { "$ref": "#/$defs/projectField" }
          }
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxActiveIssues", "branchPattern", "issueReference", "approvalPhrases", "pmTesting"],
      "properties": {
        "maxActiveIssues": { "const": 1 },
        "branchProtection": { "enum": ["enabled", "disabled"], "description": "Explicit PM choice only. Omission requires discovery and never enables or removes live protection." },
        "branchPattern": { "$ref": "#/$defs/nonEmptyString" },
        "issueReference": { "$ref": "#/$defs/nonEmptyString" },
        "approvalPhrases": {
          "type": "object",
          "additionalProperties": false,
          "required": ["issueCreation", "production", "completion", "nativeCandidate"],
          "properties": {
            "issueCreation": { "$ref": "#/$defs/nonEmptyString" },
            "production": { "$ref": "#/$defs/nonEmptyString" },
            "completion": { "$ref": "#/$defs/nonEmptyString" },
            "nativeCandidate": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        "pmTesting": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "terms", "requiredSections"],
          "properties": {
            "required": { "const": true },
            "terms": {
              "type": "array",
              "minItems": 2,
              "items": { "enum": ["Project Manager QA", "PM Testing"] }
            },
            "requiredSections": {
              "type": "array",
              "minItems": 5,
              "items": { "$ref": "#/$defs/nonEmptyString" }
            }
          }
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands", "requiredChecks"],
      "properties": {
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "requiredChecks": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "candidateIdentity", "environments"],
      "properties": {
        "strategy": {
          "enum": ["none", "immutable-promotion", "direct-production", "multi-environment"]
        },
        "candidateIdentity": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "preReleaseIdentity": {
          "type": "array", "minItems": 2, "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "description": "Identity available before merge/release approval, including sourceCommit and gitTree; subset of final candidateIdentity. None/direct legacy profiles default to source/tree, others retain full identity pending discovery."
        },
        "environments": {
          "type": "array",
          "items": { "$ref": "#/$defs/environment" }
        },
        "cycle": { "$ref": "#/$defs/releaseCycle" }
      }
    }
  },
  "$defs": {
    "releaseCycle": {
      "type": "object", "additionalProperties": false, "required": ["phases"],
      "properties": {
        "phases": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/releasePhase" } }
      }
    },
    "releasePhase": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "branch", "environments", "approvalPhrase", "readiness", "promotion", "forwardPortTo"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "kind": { "enum": ["development", "stabilization", "production"] },
        "branch": { "$ref": "#/$defs/nonEmptyString" },
        "environments": { "allOf": [{ "$ref": "#/$defs/strings" }], "minItems": 1, "description": "Names of existing release.environments entries; references are checked by profile validation." },
        "approvalPhrase": { "$ref": "#/$defs/nonEmptyString" },
        "readiness": { "allOf": [{ "$ref": "#/$defs/strings" }], "minItems": 1 },
        "promotion": { "enum": ["source", "same-artifact", "distinct-artifact"] },
        "forwardPortTo": { "$ref": "#/$defs/strings", "description": "Existing phase IDs receiving fixes; references are checked by profile validation." }
      }
    },
    "strings": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyString" } },
    "platform": {
      "type": "object", "additionalProperties": false, "required": ["os", "architecture"],
      "properties": { "os": { "$ref": "#/$defs/nonEmptyString" }, "architecture": { "$ref": "#/$defs/nonEmptyString" } }
    },
    "qa": {
      "type": "object", "additionalProperties": false,
      "required": ["applicationType", "runtimePlatforms", "candidateIdentity", "developers", "environments", "turns"],
      "allOf": [{
        "if": { "anyOf": [
          { "required": ["mode"] }, { "required": ["pms"] },
          { "properties": { "developers": { "contains": { "anyOf": [{ "required": ["kind"] }, { "required": ["github"] }] } } }, "required": ["developers"] }
        ] },
        "then": { "required": ["mode", "pms"], "properties": { "developers": { "items": { "required": ["kind", "github"] } } } }
      }],
      "properties": {
        "mode": { "const": "circulating" },
        "pms": {
          "type": "array", "minItems": 1, "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "kind"],
            "properties": { "id": { "$ref": "#/$defs/nonEmptyString" }, "kind": { "const": "human" } }
          }
        },
        "applicationType": { "enum": ["native", "web", "library", "tooling"] },
        "runtimePlatforms": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/platform" } },
        "candidateIdentity": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "developers": {
          "type": "array", "minItems": 1, "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "environments"],
            "properties": {
              "id": { "$ref": "#/$defs/nonEmptyString" }, "kind": { "const": "agent" }, "github": { "$ref": "#/$defs/nonEmptyString" },
              "environments": { "allOf": [{ "$ref": "#/$defs/strings" }], "minItems": 1 }
            }
          }
        },
        "environments": {
          "type": "array", "minItems": 1, "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "os", "architecture", "prerequisites", "setup", "suite", "teardown"],
            "properties": {
              "id": { "$ref": "#/$defs/nonEmptyString" }, "os": { "$ref": "#/$defs/nonEmptyString" }, "architecture": { "$ref": "#/$defs/nonEmptyString" },
              "prerequisites": { "$ref": "#/$defs/strings" }, "setup": { "$ref": "#/$defs/strings" },
              "suite": { "allOf": [{ "$ref": "#/$defs/strings" }], "minItems": 1 }, "teardown": { "$ref": "#/$defs/strings" }
            }
          }
        },
        "turns": {
          "type": "array", "minItems": 1, "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "developer", "environment", "pm", "approvalPhrase"],
            "properties": {
              "id": { "$ref": "#/$defs/nonEmptyString" }, "developer": { "$ref": "#/$defs/nonEmptyString" },
              "environment": { "$ref": "#/$defs/nonEmptyString" }, "pm": { "$ref": "#/$defs/nonEmptyString" }, "approvalPhrase": { "$ref": "#/$defs/nonEmptyString" }
            }
          }
        }
      }
    },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "projectField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "options"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "options": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role", "buildCommand", "deployCommand", "verifyCommand"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "role": { "enum": ["review", "production", "native"] },
        "url": { "type": "string" },
        "platform": { "type": "string" },
        "buildCommand": { "type": "string" },
        "deployCommand": { "type": "string" },
        "verifyCommand": { "$ref": "#/$defs/nonEmptyString" },
        "approvalPhrase": { "type": "string" },
        "promoteWithoutRebuild": { "type": "boolean" }
      }
    }
  }
}
