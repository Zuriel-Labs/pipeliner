{
  "$schema": "https://raw.githubusercontent.com/Zuriel-Labs/pipeliner/main/schema/pipeliner.schema.json",
  "version": 1,
  "repository": {
    "owner": "Example-Org", "name": "example-staged-service", "defaultBranch": "main", "projectManager": "project-manager"
  },
  "project": {
    "owner": "Example-Org", "number": 1, "title": "Example Staged Service", "statusField": "Status",
    "statuses": { "backlog": "Backlog", "onHold": "On Hold", "inProgress": "In Progress", "inReview": "In Review", "done": "Done" },
    "metadataFields": {
      "priority": { "name": "Priority", "options": ["P0", "P1", "P2", "P3"] },
      "impact": { "name": "Impact", "options": ["High", "Medium", "Low"] },
      "effort": { "name": "Effort", "options": ["XS", "S", "M", "L", "XL"] }
    }
  },
  "workflow": {
    "maxActiveIssues": 1, "branchPattern": "issue/{number}-{slug}", "issueReference": "Refs #{number}",
    "approvalPhrases": {
      "issueCreation": "Approved",
      "production": "Approved",
      "completion": "Approved",
      "nativeCandidate": "Approved"
    },
    "pmTesting": {
      "required": true, "terms": ["Project Manager QA", "PM Testing"],
      "requiredSections": ["target", "prerequisites", "numbered actions", "expected results", "regression checks"]
    }
  },
  "quality": { "commands": ["./scripts/check.sh"], "requiredChecks": ["Quality / verify"] },
  "release": {
    "strategy": "multi-environment",
    "preReleaseIdentity": ["sourceCommit", "gitTree", "artifactDigest"],
    "candidateIdentity": ["sourceCommit", "gitTree", "artifactDigest", "deploymentRevision"],
    "environments": [
      {
        "name": "Development", "role": "review", "url": "https://development.example.invalid",
        "buildCommand": "./scripts/build.sh development", "deployCommand": "./scripts/deploy.sh development",
        "verifyCommand": "./scripts/verify.sh development", "approvalPhrase": "Approved", "promoteWithoutRebuild": false
      },
      {
        "name": "Beta", "role": "review", "url": "https://beta.example.invalid",
        "buildCommand": "./scripts/build.sh beta", "deployCommand": "./scripts/deploy.sh beta",
        "verifyCommand": "./scripts/verify.sh beta", "approvalPhrase": "Approved", "promoteWithoutRebuild": false
      },
      {
        "name": "Production", "role": "production", "url": "https://example.invalid",
        "buildCommand": "", "deployCommand": "./scripts/promote.sh production",
        "verifyCommand": "./scripts/verify.sh production", "approvalPhrase": "Approved", "promoteWithoutRebuild": true
      }
    ],
    "cycle": {
      "phases": [
        {
          "id": "development", "kind": "development", "branch": "develop", "environments": ["Development"],
          "approvalPhrase": "Approved",
          "readiness": ["Release scope Issues are verified", "All QA turns and PMs approve the aggregate candidate", "Release scope is frozen"],
          "promotion": "source", "forwardPortTo": []
        },
        {
          "id": "beta", "kind": "stabilization", "branch": "beta", "environments": ["Beta"],
          "approvalPhrase": "Approved",
          "readiness": ["Frozen release scope has no unresolved blockers", "All QA turns and PMs approve the aggregate candidate", "Beta fixes are integrated and verified in development", "Rollback target is verified"],
          "promotion": "distinct-artifact", "forwardPortTo": ["development"]
        },
        {
          "id": "production", "kind": "production", "branch": "main", "environments": ["Production"],
          "approvalPhrase": "Approved",
          "readiness": ["Approved Beta artifact is promoted without rebuilding", "Production identity and runtime are verified", "All QA turns and PMs accept the aggregate release"],
          "promotion": "same-artifact", "forwardPortTo": []
        }
      ]
    }
  },
  "qa": {
    "mode": "circulating", "pms": [{ "id": "project-manager", "kind": "human" }],
    "applicationType": "web", "runtimePlatforms": [{ "os": "linux", "architecture": "x64" }],
    "candidateIdentity": ["sourceCommit", "gitTree"],
    "developers": [{ "id": "developer-a", "kind": "agent", "github": "developer-a", "environments": ["local-linux"] }],
    "environments": [{
      "id": "local-linux", "os": "linux", "architecture": "x64",
      "prerequisites": ["Compatible local host with project SDK and configured test fixtures"],
      "setup": ["./scripts/setup-qa.sh"], "suite": ["./scripts/check.sh", "./scripts/build.sh qa", "./scripts/smoke.sh"],
      "teardown": ["./scripts/cleanup-qa.sh"]
    }],
    "turns": [{ "id": "local", "developer": "developer-a", "environment": "local-linux", "pm": "project-manager", "approvalPhrase": "Approved" }]
  }
}
