{
  "$schema": "./schema/pipeliner.schema.json",
  "version": 1,
  "repository": {
    "owner": "Zuriel-Labs",
    "name": "pipeliner",
    "defaultBranch": "main",
    "projectManager": "brimdor"
  },
  "project": {
    "owner": "Zuriel-Labs",
    "number": 3,
    "title": "Pipeliner",
    "visibility": "PUBLIC",
    "statusField": "Status",
    "statuses": {
      "backlog": "Backlog",
      "onHold": "On Hold",
      "inProgress": "In Progress",
      "inReview": "In Review",
      "done": "Done"
    },
    "metadataFields": {
      "priority": {
        "name": "Priority",
        "options": ["P0", "P1", "P2", "P3"]
      },
      "impact": {
        "name": "Impact",
        "options": ["High", "Medium", "Low"]
      },
      "effort": {
        "name": "Effort",
        "options": ["XS", "S", "M", "L", "XL"]
      }
    }
  },
  "workflow": {
    "branchProtection": "disabled",
    "maxActiveIssues": 1,
    "branchPattern": "issue/{number}-{slug}",
    "issueReference": "Refs #{number}",
    "approvalPhrases": {
      "issueCreation": "Approved to create this exact GitHub Issue",
      "production": "Approved to merge and deploy production",
      "completion": "Approved to complete Issue #{number}",
      "nativeCandidate": "Beta approved"
    },
    "pmTesting": {
      "required": true,
      "terms": ["Project Manager QA", "PM Testing"],
      "requiredSections": ["target", "prerequisites", "numbered actions", "expected results", "regression checks"]
    }
  },
  "quality": {
    "commands": ["npm run check"],
    "requiredChecks": ["Quality / verify"]
  },
  "release": {
    "strategy": "none",
    "preReleaseIdentity": ["sourceCommit", "gitTree"],
    "candidateIdentity": ["sourceCommit", "gitTree"],
    "environments": []
  },
  "qa": {
    "applicationType": "tooling",
    "runtimePlatforms": [{ "os": "macos", "architecture": "arm64" }],
    "candidateIdentity": ["sourceCommit", "gitTree"],
    "developers": [{ "id": "brimdor", "environments": ["local-mac"] }],
    "environments": [{
      "id": "local-mac", "os": "macos", "architecture": "arm64",
      "prerequisites": ["Apple Silicon Mac with Node.js 22+, Git and authenticated GitHub CLI"],
      "setup": [],
      "suite": ["npm run check"],
      "teardown": []
    }],
    "turns": [{ "id": "local", "developer": "brimdor", "environment": "local-mac", "pm": "brimdor", "approvalPhrase": "Beta approved" }]
  }
}
